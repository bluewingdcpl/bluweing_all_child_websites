{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:page(.*?\\.html)/:rest(.*)",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/projects/:slug([a-z0-9-]+)\\.html",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/blog/:slug([a-z0-9-]+)\\.html",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": { "re": "sygnific" } }],
      "destination": "/sygnificinfra/sygnific-infra.html"
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": { "re": "sygnific" } }],
      "destination": "/sygnificinfra/:path"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": { "re": "bhaarat" } }],
      "destination": "/bhaaratprecast/bhaarat-precast.html"
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": { "re": "bhaarat" } }],
      "destination": "/bhaaratprecast/:path"
    },
    {
      "source": "/",
      "destination": "/bluewing/index.html"
    },
    {
      "source": "/blog/:slug([a-z0-9]+(?:-[a-z0-9]+)*)",
      "destination": "/bluewing/blog-post.html"
    },
    {
      "source": "/:slug((?!(?:api|blog|projects|assets|new-pillar)$)[a-z0-9]+(?:-[a-z0-9]+)*)",
      "destination": "/bluewing/project-view.html"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/bluewing/:path"
    }
  ]
}
